<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DeckRemote"
        x:Class="DeckRemote.MainWindow"
        Title="Deck Remote" Width="1120" Height="700" MinWidth="790" MinHeight="550"
        WindowStartupLocation="CenterScreen" Background="#0D141C" Foreground="#F2F6FA">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinHeight" Value="43" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pc-action">
      <Setter Property="Background" Value="#243343" />
      <Setter Property="BorderBrush" Value="#506477" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="37" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pc-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33495A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.pc-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#405969" />
    </Style>
    <Style Selector="Button.pc-primary">
      <Setter Property="Background" Value="#26EDB6" />
      <Setter Property="Foreground" Value="#09241B" />
      <Setter Property="BorderBrush" Value="#26EDB6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.pc-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#78F7D1" />
      <Setter Property="Foreground" Value="#09241B" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="Foreground" Value="#B0C1CF" />
    </Style>
    <Style Selector="TextBlock.status.ready">
      <Setter Property="Foreground" Value="#26EDB6" />
    </Style>
    <Style Selector="TextBlock.status.warning">
      <Setter Property="Foreground" Value="#FFBE58" />
    </Style>
    <Style Selector="Ellipse.status">
      <Setter Property="Fill" Value="#8094A4" />
    </Style>
    <Style Selector="Ellipse.status.ready">
      <Setter Property="Fill" Value="#26EDB6" />
    </Style>
    <Style Selector="Ellipse.status.warning">
      <Setter Property="Fill" Value="#FFBE58" />
    </Style>
    <Style Selector="Path.driver-icon">
      <Setter Property="Stroke" Value="#8094A4" />
    </Style>
    <Style Selector="Path.driver-icon.ready">
      <Setter Property="Stroke" Value="#26EDB6" />
    </Style>
    <Style Selector="Path.driver-icon.warning">
      <Setter Property="Stroke" Value="#FFBE58" />
    </Style>
    <Style Selector="ToggleButton.startup-switch">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="SwitchTrack" CornerRadius="12" BorderThickness="1"
                  Background="#263545" BorderBrush="#536879">
            <Ellipse x:Name="SwitchThumb" Fill="#F2F6FA" Width="16" Height="16" Margin="3,0"
                     HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.startup-switch:checked /template/ Border#SwitchTrack">
      <Setter Property="Background" Value="#26EDB6" />
      <Setter Property="BorderBrush" Value="#26EDB6" />
    </Style>
    <Style Selector="ToggleButton.startup-switch:checked /template/ Ellipse#SwitchThumb">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="ToggleButton.startup-switch:pointerover /template/ Border#SwitchTrack">
      <Setter Property="BorderBrush" Value="#C4D6E1" />
    </Style>
    <Style Selector="ToggleButton.startup-switch:disabled /template/ Border#SwitchTrack">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </Window.Styles>

  <Grid x:Name="WindowsLayout" ColumnDefinitions="27*,73*" ColumnSpacing="12" Margin="12">
    <Border Background="#151E28" CornerRadius="13" Padding="18,21,18,15">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="244" HorizontalAlignment="Left">
              <Canvas Width="244" Height="94">
                <Rectangle Canvas.Left="1" Canvas.Top="1" Width="242" Height="92" RadiusX="27" RadiusY="27"
                           Stroke="#A4B6C6" StrokeThickness="2" />
                <Rectangle Canvas.Left="60" Canvas.Top="8" Width="124" Height="78" RadiusX="2" RadiusY="2"
                           Stroke="#8DA3B5" StrokeThickness="1.5" />
                <Path Canvas.Left="10" Canvas.Top="11" Stroke="#A4B6C6" StrokeThickness="1.5"
                      Data="M6 0 H11 V6 H17 V11 H11 V17 H6 V11 H0 V6 H6 Z" />
                <Ellipse Canvas.Left="34" Canvas.Top="17" Width="16" Height="16" Stroke="#A4B6C6" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="193" Canvas.Top="17" Width="16" Height="16" Stroke="#A4B6C6" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="223" Canvas.Top="9" Width="6" Height="6" Fill="#A4B6C6" />
                <Ellipse Canvas.Left="216" Canvas.Top="16" Width="6" Height="6" Fill="#A4B6C6" />
                <Ellipse Canvas.Left="230" Canvas.Top="16" Width="6" Height="6" Fill="#A4B6C6" />
                <Ellipse Canvas.Left="223" Canvas.Top="23" Width="6" Height="6" Fill="#A4B6C6" />
                <Rectangle Canvas.Left="23" Canvas.Top="42" Width="31" Height="24" RadiusX="3" RadiusY="3"
                           Stroke="#A4B6C6" StrokeThickness="1.5" />
                <Rectangle Canvas.Left="190" Canvas.Top="42" Width="31" Height="24" RadiusX="3" RadiusY="3"
                           Stroke="#A4B6C6" StrokeThickness="1.5" />
                <Rectangle Canvas.Left="40" Canvas.Top="74" Width="11" Height="5" RadiusX="2" RadiusY="2" Stroke="#A4B6C6" />
                <Rectangle Canvas.Left="193" Canvas.Top="74" Width="11" Height="5" RadiusX="2" RadiusY="2" Stroke="#A4B6C6" />
              </Canvas>
            </Viewbox>

            <StackPanel Spacing="8">
              <TextBlock x:Name="DeviceName" Text="Steam Deck" FontSize="25" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                <Ellipse x:Name="ConnectionDot" Classes="status" Width="11" Height="11" VerticalAlignment="Center" />
                <TextBlock x:Name="ConnectionTitle" Grid.Column="1" Classes="status" Text="正在启动"
                           FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
              <TextBlock x:Name="ConnectionDetail" Foreground="#B0C1CF" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>

            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <Button x:Name="ConnectionAction" Classes="pc-action pc-primary" IsVisible="False" Click="OnConnectionAction" />
              <Button x:Name="SecondaryAction" Classes="pc-action" Width="47" Padding="0" IsVisible="False"
                      AutomationProperties.Name="暂停接收" ToolTip.Tip="暂停接收" Click="OnSecondaryAction">
                <Panel Width="18" Height="18">
                  <PathIcon x:Name="PauseIcon" Data="M3 1 H7 V17 H3 Z M11 1 H15 V17 H11 Z" />
                  <PathIcon x:Name="ResumeIcon" Data="M3 1 L16 9 L3 17 Z" IsVisible="False" />
                </Panel>
              </Button>
              <Button x:Name="MoreButton" Classes="pc-action" Width="47" Padding="0" IsVisible="False"
                      AutomationProperties.Name="设备操作" ToolTip.Tip="设备操作">
                <PathIcon Width="19" Height="16" Data="M3 6 A2 2 0 1 0 3 10 A2 2 0 1 0 3 6 Z M10 6 A2 2 0 1 0 10 10 A2 2 0 1 0 10 6 Z M17 6 A2 2 0 1 0 17 10 A2 2 0 1 0 17 6 Z" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="解除配对" Click="OnForget" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </WrapPanel>

            <Border x:Name="PairingPanel" Background="#111A23" BorderBrush="#43596A" BorderThickness="1"
                    CornerRadius="9" Padding="12" IsVisible="False">
              <StackPanel Spacing="9">
                <TextBlock x:Name="PairingTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="请核对两端的验证码。" Foreground="#B0C1CF" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                  <TextBlock Text="PC" VerticalAlignment="Center" />
                  <TextBlock x:Name="PcCode" Grid.Column="1" FontFamily="monospace" FontSize="16" Foreground="#26EDB6" />
                  <TextBlock Grid.Row="1" Text="Deck" VerticalAlignment="Center" />
                  <TextBlock x:Name="DeckCode" Grid.Row="1" Grid.Column="1" FontFamily="monospace"
                             FontSize="16" Foreground="#26EDB6" />
                </Grid>
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button x:Name="ApproveButton" Classes="pc-action pc-primary" Content="确认一致" Click="OnApprove" />
                  <Button Classes="pc-action" Content="取消" Click="OnReject" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <StackPanel x:Name="PcPanel" Spacing="10" IsVisible="False">
              <Border Height="1" Background="#465968" Margin="0,1,0,4" />
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Path x:Name="DriverIcon" Classes="driver-icon" Width="22" Height="23" Stretch="Uniform" StrokeThickness="1.65"
                      Data="M10 1 L19 4 V10 C19 15 15 19 10 21 C5 19 1 15 1 10 V4 Z M5.5 10.5 L9 14 L14.5 8.5" />
                <TextBlock Grid.Column="1" Text="ViGEmBus" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="DriverStatus" Grid.Column="2" Classes="status" Text="检测中" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="DriverDetail" Foreground="#B0C1CF" TextWrapping="Wrap" IsVisible="False" />
              <WrapPanel x:Name="DriverActions" ItemSpacing="8" LineSpacing="8" IsVisible="False">
                <Button Classes="pc-action" Content="安装驱动" Click="OnDriverDownload" />
                <Button Classes="pc-action" Content="重新检测" Click="OnDriverCheck" />
              </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="LocalStatus" Foreground="#FFBE58" TextWrapping="Wrap" IsVisible="False" />
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="StartupRow" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#465968"
                Margin="0,10,0,0" Padding="0,14,0,0" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="登录 Windows 时启动" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleButton x:Name="AutoStart" Grid.Column="1" Classes="startup-switch"
                          AutomationProperties.Name="登录 Windows 时启动" IsCheckedChanged="OnAutoStartChanged" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="InputPanel" Grid.Column="1" CornerRadius="13" Padding="19,17,19,19" Background="#121C26"
            BorderBrush="#455A6B" BorderThickness="1" IsVisible="False">
      <local:ControllerPreview x:Name="InputPreview" />
    </Border>
  </Grid>
</Window>

