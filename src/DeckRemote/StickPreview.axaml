<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DeckRemote"
             x:Class="DeckRemote.StickPreview">
  <UserControl.Styles>
    <Style Selector="Border.stick-card">
      <Setter Property="BorderBrush" Value="#455A6B" />
    </Style>
    <Style Selector="Border.stick-card.pressed">
      <Setter Property="BorderBrush" Value="#26EDB6" />
    </Style>
    <Style Selector="TextBlock.stick-label.pressed">
      <Setter Property="Foreground" Value="#26EDB6" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="Card" Classes="stick-card" CornerRadius="12" BorderThickness="1"
          Background="#101923" Padding="13,10">
    <Grid RowDefinitions="Auto,*">
      <TextBlock x:Name="StickLabel" Classes="stick-label" FontSize="19" FontWeight="SemiBold" />
      <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">
        <Grid ColumnDefinitions="133,96" ColumnSpacing="13">
          <local:StickPlot x:Name="Plot" Width="133" Height="133" />
          <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*"
                ColumnSpacing="8" RowSpacing="12" VerticalAlignment="Center">
            <TextBlock Text="X" Foreground="#B0C1CF" FontSize="17" />
            <TextBlock x:Name="AxisX" Grid.Column="1" Text="0" FontFamily="monospace" FontSize="17" />
            <TextBlock Grid.Row="1" Text="Y" Foreground="#B0C1CF" FontSize="17" />
            <TextBlock x:Name="AxisY" Grid.Row="1" Grid.Column="1" Text="0" FontFamily="monospace" FontSize="17" />
          </Grid>
        </Grid>
      </Viewbox>
    </Grid>
  </Border>
</UserControl>

